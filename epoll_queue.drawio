<mxfile host="app.diagrams.net" agent="proxy-epoll-kqueue">
  <diagram name="1 · Arquitectura" id="arq-implementada">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t1" value="Proxy inverso L7 — arquitectura implementada" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Un proceso por CPU, sin estado compartido entre ellos. Cada worker: un bucle de eventos + dos hilos auxiliares." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="820" height="24" as="geometry" />
        </mxCell>

        <mxCell id="cli" value="Clientes&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#666666&quot;&gt;curl · wrk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="110" height="70" as="geometry" />
        </mxCell>

        <mxCell id="fgrp" value="listener — SO_REUSEPORT" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="190" y="330" width="170" height="190" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="frontend &quot;public&quot;&lt;br&gt;:80" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="205" y="365" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="frontend &quot;internal&quot;&lt;br&gt;:8081" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="205" y="440" width="140" height="55" as="geometry" />
        </mxCell>

        <mxCell id="wgrp" value="Worker 0 … N-1   ·   un proceso por CPU" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="110" width="760" height="720" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="io_event — bucle de eventos&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;epoll (Linux) · kqueue (macOS/BSD)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot; color=&quot;#b85450&quot;&gt;edge-triggered: drenar hasta EAGAIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="430" y="150" width="300" height="80" as="geometry" />
        </mxCell>

        <mxCell id="conn" value="connection — máquina de estados&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;relay bidireccional · keep-alive&lt;br&gt;contrapresión: si el buffer llena, deja de leer&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="270" width="300" height="90" as="geometry" />
        </mxCell>

        <mxCell id="hp" value="http_parser&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Host · X-Forwarded-*&lt;br&gt;delimita cuerpos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="400" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="bp" value="buffer_pool&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;arena mmap&lt;br&gt;slots de 16 KB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="590" y="400" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="slot" value="router_slot — publicación RCU&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;intercambio atómico + refcount&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="150" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rt" value="router — una tabla por frontend&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;exacto (djb2) → *.dom → default → 502&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="235" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pool" value="backend_pool × N&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;round_robin · weighted · least_conn&lt;br&gt;salud pasiva: fall fallos ⇒ DOWN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="790" y="320" width="340" height="75" as="geometry" />
        </mxCell>

        <mxCell id="thr" value="Hilos auxiliares del worker" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;verticalAlign=top;fontSize=10;fontColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="790" y="430" width="340" height="120" as="geometry" />
