        <mxCell id="lg" value="hilo log&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;anillo 4096×512 B&lt;br&gt;lleno ⇒ descarta y cuenta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="805" y="460" width="150" height="75" as="geometry" />
