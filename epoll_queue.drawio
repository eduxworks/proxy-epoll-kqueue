        <mxCell id="sig" value="SIGHUP → self-pipe&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;handler: solo write()&lt;br&gt;reload roto ⇒ se conserva la anterior&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
