        <mxCell id="st" value="stats — socket UNIX (solo worker 0)&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;snapshot JSON: uptime, contadores, backends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
