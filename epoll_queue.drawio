        <mxCell id="key" value="Por qué esto no corta tráfico&lt;br&gt;&lt;br&gt;Cada conexión toma una referencia al router al nacer y la suelta al cerrar,&#10;así que termina con la configuración con la que empezó. Los pools viven&#10;dentro del router: el mismo refcount que protege la tabla de rutas protege&#10;el estado de salud al que apunta.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Comprobado en el e2e: con wrk en marcha, kill -HUP no produce ni un error.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="900" height="150" as="geometry" />
        </mxCell>
      </root>
