        </mxCell>

        <mxCell id="fail" value="Si algo falla: se conserva la configuración anterior&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;TOML inválido · backend inexistente · cambio de puertos o de número de frontends&lt;br&gt;Un reload roto no puede degradar el servicio.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="400" y="320" width="520" height="70" as="geometry" />
