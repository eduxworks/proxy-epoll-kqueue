        <mxCell id="note1" value="Solo 3 ficheros tienen #ifdef de plataforma:&lt;br&gt;io_event_epoll.c · io_event_kqueue.c · net_compat.c&lt;br&gt;&lt;br&gt;SO_REUSEPORT no significa lo mismo en los tres SO:&lt;br&gt;Linux reparte · FreeBSD necesita _LB · macOS NO reparte" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontSize=10;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1210" y="500" width="330" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="2 · Estados de conexión" id="estados-conexion">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="s_t" value="Máquina de estados de una conexión" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_t2" value="Con keep-alive el ciclo vuelve a empezar sin cerrar nada: es lo que evita un handshake por petición." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="900" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s0" value="ACCEPTED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="READING_REQUEST&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;≤ 8 KB de cabeceras&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="250" y="225" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="CONNECTING&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;connect no bloqueante&lt;br&gt;hasta 3 backends&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="225" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="PROXYING&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;relay en los dos sentidos&lt;br&gt;delimita la respuesta&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="750" y="225" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="CLOSING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1010" y="230" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="err" value="Respuesta de error y cierre&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;400 sin Host o mal formada · 431 cabeceras enormes&lt;br&gt;502 sin ruta o sin backend vivo · 503 sin buffers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="430" y="430" width="380" height="80" as="geometry" />
        </mxCell>

        <mxCell id="ka" value="keep-alive: si cliente y respuesta lo permiten,&lt;br&gt;vuelve a READING_REQUEST reutilizando el upstream&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;(solo si el nuevo Host enruta al mismo pool)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="500" y="90" width="420" height="60" as="geometry" />
        </mxCell>

        <mxCell id="se0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="s0" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se1" value="Host resuelto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se2" value="conectado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se3" value="fin de respuesta&lt;br&gt;o EOF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se4" value="parseo inválido" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="s1" target="err">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se5" value="sin backend vivo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="s2" target="err">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="err" target="s4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="se7" value="keep-alive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#82b366;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="inv" value="Dos invariantes que gobiernan cada transición&lt;br&gt;&lt;br&gt;1 · Edge-triggered obliga a drenar. El kernel avisa una vez por transición:&#10;cada handler lee y escribe hasta EAGAIN. Lo que no se drena no vuelve a avisarse.&lt;br&gt;&lt;br&gt;2 · Contrapresión en vez de buffers que crecen. Si el buffer de salida se llena,&#10;se deja de leer del otro extremo. Un upstream lento no se traduce en memoria." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;fontSize=11;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="750" height="150" as="geometry" />
        </mxCell>

        <mxCell id="fram" value="Delimitar el cuerpo es lo que permite reutilizar&lt;br&gt;&lt;br&gt;Content-Length ⇒ tras N bytes&lt;br&gt;chunked ⇒ chunk 0 + tráiler&lt;br&gt;1xx / 204 / 304 / HEAD ⇒ sin cuerpo&lt;br&gt;sin delimitador ⇒ acaba al cerrar: NO reutilizable&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;Contar mal aquí sirve media respuesta&#10;como si fuera la siguiente.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;fontSize=11;verticalAlign=top;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="850" y="600" width="400" height="150" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3 · Recarga en caliente" id="recarga-rcu">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="r_t" value="Recarga en caliente — SIGHUP sin cortar conexiones" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_t2" value="La configuración publicada es inmutable: recargar es construir otra y sustituir el puntero, nunca mutar la que está en uso." style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1000" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="1 · SIGHUP&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;el handler solo hace write()&lt;br&gt;de 1 byte al self-pipe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="2 · El bucle despierta&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;lee el pipe drenando&lt;br&gt;hasta EAGAIN&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
