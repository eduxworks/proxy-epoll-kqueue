        <mxCell id="old" value="Router VIEJO&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;refcount &gt; 0: lo sostienen&lt;br&gt;las conexiones en vuelo&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
