        <mxCell id="he" value="hilo health&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;sondas TCP/HTTP&lt;br&gt;las únicas que readmiten&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="965" y="460" width="150" height="75" as="geometry" />
